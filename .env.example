# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=duanmau_atgt
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- App ---
APP_ENV=local
APP_DEBUG=true

# --- SMTP (tuy chon, chua bat) ---
SMTP_USER=
SMTP_PASSWORD=

# --- AI Camera ---
AI_CAMERA_ENABLED=false
ROBOFLOW_PUBLISHABLE_KEY=
# Default: Roboflow's canonical hard-hat demo model — works cho helmet noi chung.
# Swap sang model chuyen bike/motorcycle helmet neu can:
#   https://universe.roboflow.com/search?q=helmet+detection
ROBOFLOW_MODEL=hard-hat-workers/12

# AI providers (keep secrets only in .env, never in PHP source)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
AI_RATE_LIMIT=30
